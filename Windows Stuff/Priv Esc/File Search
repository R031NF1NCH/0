## File Search Commands

# Edited by My user — last 5 min
$me = "$env:USERDOMAIN\$env:USERNAME"; Get-ChildItem C:\ -Recurse -Force -ErrorAction SilentlyContinue | Where { $_.LastWriteTime -gt (Get-Date).AddMinutes(-5) -and {try{(Get-Acl $_.FullName -ErrorAction Stop).Owner -eq $me}catch{$false}} } | Select FullName, LastWriteTime | Format-Table -Auto

# Edited by My user — last 25 min searching only in C:\Users,C:\Temp,C:\Windows\Temp,C:\ProgramData 
$me = "$env:USERDOMAIN\$env:USERNAME"; Get-ChildItem C:\Users,C:\Temp,C:\Windows\Temp,C:\ProgramData -Recurse -Force -ErrorAction SilentlyContinue | Where { $_.LastWriteTime -gt (Get-Date).AddMinutes(-25) -and {try{(Get-Acl $_.FullName -ErrorAction Stop).Owner -eq $me}catch{$false}} } | Select FullName, LastWriteTime | Format-Table -Auto

# Edited by My user — last 24 h (the one you ran)
$me = "$env:USERDOMAIN\$env:USERNAME"; Get-ChildItem C:\ -Recurse -Force -ErrorAction SilentlyContinue | Where { $_.LastWriteTime -gt (Get-Date).AddHours(-24) -and {try{(Get-Acl $_.FullName -ErrorAction Stop).Owner -eq $me}catch{$false}} } | Select FullName, LastWriteTime | Format-Table -Auto

# Files changed by domain Administrator (last 24 hours)
$admin="YOURDOMAIN\Administrator"; Get-ChildItem C:\ -Recurse -Force -ErrorAction SilentlyContinue | Where { $_.LastWriteTime -gt (Get-Date).AddHours(-24) -and {try{(Get-Acl $_.FullName -ErrorAction Stop).Owner -like "*\$admin"}catch{$false}} } | Select FullName, LastWriteTime | Format-Table -Auto

# Files changed by local user (non-Domain user) Sarah (last 24 hours)
$sarah=".\Sarah"; Get-ChildItem C:\ -Recurse -Force -ErrorAction SilentlyContinue | Where { $_.LastWriteTime -gt (Get-Date).AddHours(-24) -and {try{(Get-Acl $_.FullName -ErrorAction Stop).Owner -like "*\$sarah"}catch{$false}} } | Select FullName, LastWriteTime | Format-Table -Auto

# Files changed by David in the last 24 hrs. Uses asterisk in search so searches both domain and local users named david. Change David to any other user.
Get-ChildItem C:\ -Recurse -Force -ErrorAction SilentlyContinue | Where { $_.LastWriteTime -gt (Get-Date).AddHours(-24) -and {try{(Get-Acl $_.FullName -ErrorAction Stop).Owner -like "*\David"}catch{$false}} } | Select FullName, LastWriteTime | Format-Table -Auto



# Searches the entire C: drive recursively for the file "local.txt" and lists the full path in bare format. In Command Prompt:
dir C:\local.txt /s /b

# Recursively searches the C: drive for "local.txt", handles errors silently, includes hidden files, and outputs full paths. In PowerShell:
Get-ChildItem -Path C:\ -Recurse -Filter local.txt -ErrorAction SilentlyContinue -Force | Select-Object FullName

Get-ChildItem -Path C:\ -Include *.kdbx -File -Recurse -ErrorAction SilentlyContinue    #Search for Keepass database - PowerShell with the Get-ChildItem cmdlet to locate files in specified locations. We'll use -Path C:\ to search the whole drive. Next use -Include to specify file types to include, -File and -Recurse arguments to get list of files and search in subdirectories. Set -ErrorAction to SilentlyContinue to silence errors and continue execution.

# Recursively lists all files in the C: drive and filters for those named "local.txt".
where /R C:\ local.txt

# Uses PowerShell alias 'dir' to recursively search C: for "local.txt", silences errors, and outputs full names.
dir C:\ -r -fi local.txt -ea SilentlyContinue | % {$_.FullName}

# Recursively searches C: drive using a loop to find and echo full paths of "local.txt". In Command Prompt:
for /r C:\ %i in (local.txt) do @echo %~fi

# Filters all items recursively in C: for exact name match to "local.txt" and selects full paths. In PowerShell:
gci C:\ -r -ea SilentlyContinue | where {$_.Name -eq 'local.txt'} | select FullName

# Lists all files recursively in bare format and pipes to find lines containing "local.txt". In Command Prompt:
dir /s /b C:\ | find "local.txt"

# Uses -Include for recursive search of "local.txt" on C:, silences errors, and lists full names. In PowerShell:
Get-ChildItem -Path C:\ -Recurse -Include local.txt -ErrorAction SilentlyContinue | Select-Object FullName

# Recursively searches with Force to include hidden/system files and formats output as list of full names. In PowerShell:
Get-ChildItem -Path C:\ -Recurse -Filter local.txt -Force -ErrorAction SilentlyContinue | Format-List FullName

# Lists directory tree with files and filters for "local.txt" occurrences. In Command Prompt:
tree C:\ /f | find "local.txt"
