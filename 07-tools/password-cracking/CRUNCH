# Create Password Lists
crunch 6 6 -t Lab%%% > wordlist    # Create custom password list using crunch. Min/max length set to 6 and first 3 letters of password are Lab
crunch 4 8 -o wordlist.txt    # Generate passwords of 4 to 8 characters using default lowercase charset and save to wordlist.txt
crunch 6 6 -f /usr/share/crunch/charset.lst numeric -o numbers.txt    # Create 6-digit numeric passwords using charset file
crunch 8 8 -t @@@Pass%% -o custom.txt    # Generate 8-character passwords with 3 lowercase letters, fixed "Pass", and 2 digits
crunch 5 5 -p dog cat bird    # Generate all permutations of the words dog, cat, and bird, ignoring length parameters
crunch 4 4 -d 2@ -o limited.txt    # Generate 4-character lowercase passwords with a limit of 2 repeated characters
crunch 6 6 -t ,@% -b 10mb -o split.txt    # Generate 6-character passwords (uppercase, lowercase, digit) and split output into 10MB files
crunch 7 7 -s abc1234 -e xyz9999 -o range.txt    # Generate 7-character passwords starting at abc1234 and ending at xyz9999
crunch 5 5 -t ^%@ -c 1000 -o short.txt    # Generate up to 1000 passwords with symbol, lowercase, digit pattern
crunch 8 8 -z gzip -o compressed.gz    # Generate 8-character passwords and compress output to gzip format
