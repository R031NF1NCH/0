#Preparing hash for cracking in jtr format, needs editing to use in hashcat
ssh2john id_rsa > ssh.hash            #Use ssh2john tograb password hash from ssh key
zip2john /path/to/your/protected.zip > ziphash.txt    #Use zip2john tograb password hash from zip
keepass2john Database.kdbx > keepass.hash            #Use keepass2john tograb password hash from keepass


#Create Password Lists
crunch 6 6 -t Lab%%% > wordlist    #Create custom password list using crunch. Min/max length set to 6 and first 3 letter of password are Lab


