# Cracking password with JTR
john hash.txt    # Use John the Ripper default settings to attack the hash
john hash.txt --wordlist=~/wordlists/rockyou.txt    # Use wordlist to crack hash
john hash.txt --format=raw-md5    # Crack raw MD5 hashes with default attack modes
john hash.txt --format=nt --wordlist=/usr/share/wordlists/rockyou.txt    # Crack NTLM hashes using rockyou wordlist
john hash.txt --format=sha256-crypt --wordlist=wordlist.txt    # Crack SHA-256 crypt hashes with a custom wordlist
john hash.txt --incremental    # Run incremental mode (brute-force) for all possible character combinations
john hash.txt --format=md5crypt --wordlist=wordlist.txt --rules    # Apply wordlist mangling rules to crack MD5 crypt hashes
john hash.txt --format=bcrypt    # Crack bcrypt hashes using default settings
john hash.txt --wordlist=wordlist.txt --rules=jumbo    # Use jumbo rules for advanced wordlist mangling
john hash.txt --single    # Run single crack mode using login-related information
john hash.txt --format=lm    # Crack LAN Manager (LM) hashes
john hash.txt --format=sha512-crypt --wordlist=wordlist.txt    # Crack SHA-512 crypt hashes with a wordlist
john --show hash.txt    # Display cracked passwords from a previous session
john hash.txt --format=raw-sha1 --incremental=digits    # Brute-force SHA-1 hashes with digits only
john hash.txt --format=nt --mask=?l?l?l?l?d?d    # Use mask attack for 4 lowercase letters + 2 digits
john hash.txt --wordlist=wordlist.txt --rules=wordlist    # Apply custom wordlist rules for mangling
john hash.txt --format=pbkdf2-hmac-sha256    # Crack PBKDF2-HMAC-SHA256 hashes
john hash.txt --loopback --wordlist=cracked.txt    # Use previously cracked passwords as a wordlist
john hash.txt --format=raw-sha256 --fork=4    # Crack SHA-256 hashes using 4 parallel processes
john hash.txt --wordlist=wordlist.txt --stdout | hashcat -a 0 -m 0 -    # Pipe John’s output to hashcat for hybrid attack
john hash.txt --format=md5crypt --max-run-time=3600    # Limit cracking session to 1 hour
john hash.txt --format=nt --wordlist=wordlist.txt --rules=korelogic    # Use KoreLogic rules for advanced mangling
john hash.txt --format=raw-md5 --incremental=lower    # Brute-force lowercase passwords for raw MD5 hashes
john hash.txt --format=sha1-crypt --wordlist=wordlist.txt --min-length=8    # Crack SHA-1 crypt hashes with minimum length 8
john hash.txt --format=nt --mask=?u?u?d?d?d    # Mask attack for 2 uppercase letters + 3 digits
john hash.txt --wordlist=wordlist.txt --rules --dupe-suppression    # Suppress duplicate guesses in wordlist mode
john hash.txt --format=bcrypt --progress-only    # Show progress for bcrypt hash cracking
john hash.txt --format=raw-sha512 --wordlist=wordlist.txt --rules=extra    # Use extra rules for SHA-512 hash cracking
john hash.txt --format=nt --session=mysession    # Save cracking session with a custom name
john --restore=mysession    # Restore a previously saved cracking session
john hash.txt --format=md5crypt --wordlist=wordlist.txt --max-length=12    # Limit guesses to 12 characters for MD5 crypt
john hash.txt --format=raw-md5 --markov=200    # Use Markov mode with a stat level of 200
john hash.txt --format=nt --external=leet    # Apply custom external mode (e.g., leet transformations)
john hash.txt --format=sha256-crypt --wordlist=wordlist.txt --fork=2    # Crack SHA-256 crypt with 2 parallel processes
john hash.txt --format=raw-md5 --prince=wordlist.txt    # Use PRINCE mode with a wordlist for combinator attack
john hash.txt --format=nt --wordlist=wordlist.txt --rules --mem-file=memfile.txt    # Use memory file for large wordlists
